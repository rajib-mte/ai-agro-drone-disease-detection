### 2. Train the model: `train.py`

```python
import tensorflow as tf

DATA_DIR = "dataset"
IMG_SIZE = (224, 224)
BATCH = 16

train_ds = tf.keras.utils.image_dataset_from_directory(
    DATA_DIR,
    validation_split=0.2,
    subset="training",
    seed=123,
    image_size=IMG_SIZE,
    batch_size=BATCH
)

val_ds = tf.keras.utils.image_dataset_from_directory(
    DATA_DIR,
    validation_split=0.2,
    subset="validation",
    seed=123,
    image_size=IMG_SIZE,
    batch_size=BATCH
)

class_names = train_ds.class_names
print("Classes:", class_names)

base = tf.keras.applications.MobileNetV2(
    input_shape=(224, 224, 3),
    include_top=False,
    weights="imagenet"
)
base.trainable = False

model = tf.keras.Sequential([
    tf.keras.layers.Rescaling(1./255),
    base,
    tf.keras.layers.GlobalAveragePooling2D(),
    tf.keras.layers.Dense(len(class_names), activation="softmax")
])

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

model.fit(train_ds, validation_data=val_ds, epochs=10)
model.save("rice_model.keras")

with open("classes.txt", "w") as f:
    f.write("\n".join(class_names))
```

Run:

```bash
python train.py
```

### 3. Real-time webcam/drone camera: `realtime.py`

```python
import cv2
import numpy as np
import tensorflow as tf

model = tf.keras.models.load_model("rice_model.keras")

with open("classes.txt") as f:
    class_names = [line.strip() for line in f]

# 0 = laptop webcam
# For drone/IP camera, replace 0 with RTSP/HTTP stream URL
cap = cv2.VideoCapture(0)

while True:
    ret, frame = cap.read()
    if not ret:
        print("Camera not found")
        break

    img = cv2.resize(frame, (224, 224))
    img = np.expand_dims(img, axis=0)

    preds = model.predict(img, verbose=0)[0]
    idx = np.argmax(preds)
    label = class_names[idx]
    confidence = preds[idx] * 100

    cv2.putText(
        frame,
        f"{label}: {confidence:.1f}%",
        (20, 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (0, 255, 0),
        2
    )

    cv2.imshow("Rice Leaf Disease Detection", frame)

    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

cap.release()
cv2.destroyAllWindows()
```

Run:

```bash
python realtime.py
```

For a drone camera, change:

```python
cap = cv2.VideoCapture(0)
```

to something like:

```python
cap = cv2.VideoCapture("rtsp://your-drone-camera-url")
```

Main issue: this dataset is very small, so for real drone field use you should collect your own rice leaf images from your camera and retrain/fine-tune the model.

